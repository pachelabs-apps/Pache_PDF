<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto del paquete MSIX de Ozone PDF para la Microsoft Store.
  CREAR_MSIX.bat reemplaza los valores entre $...$:
  - $NOMBRE$ y $EDITOR$: la identidad que asigna Partner Center al reservar el nombre
    (Producto > Administración de productos > Identidad del producto). Se guardan en
    msix_identidad.txt.
  - $VERSION$: la versión de app.py, con cuatro números (1.1.0 -> 1.1.0.0).
  La Store firma el paquete al publicarlo: no hace falta certificado propio.
  A diferencia del instalador .exe/.msi, un paquete MSIX no puede crear reglas de firewall;
  la garantía de "sin red" de esta versión es que el programa se compila sin los módulos
  de red de Python (la autoprueba lo verifica).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="$NOMBRE$" Publisher="$EDITOR$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Ozone PDF</DisplayName>
    <PublisherDisplayName>PacheLab</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-AR" />
  </Resources>

  <Applications>
    <Application Id="OzonePDF" Executable="Ozone PDF.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Ozone PDF"
        Description="Herramientas PDF gratis que funcionan sin internet: unir, dividir, comprimir, convertir, proteger y escanear con la cámara."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- programa de escritorio clásico (obligatorio para apps Win32 empaquetadas) -->
    <rescap:Capability Name="runFullTrust" />
    <!-- cámara, para "Fotos a PDF"; Windows la muestra en Configuración > Privacidad > Cámara -->
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
